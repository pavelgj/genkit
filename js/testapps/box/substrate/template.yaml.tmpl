# ActorTemplate for the boxed agent. setup.sh fills in ATESPACE, TEMPLATE,
# IMAGE (pinned by digest, as substrate requires), BUCKET, MODEL_GATEWAY_URL
# and AGENT_MODEL. No secrets: the box calls models through the gateway.
metadata:
  atespace: ${ATESPACE}
  name: ${TEMPLATE}
workerSelector:
  matchLabels:
    workload: ${ATESPACE}
containers:
- name: box
  image: ${IMAGE}
  env:
  # Serve Genkit's V1 reflection API on the port atenet-router targets.
  - name: GENKIT_ENV
    value: dev
  - name: GENKIT_REFLECTION_HOST
    value: 0.0.0.0
  - name: GENKIT_REFLECTION_PORT
    value: "80"
  # Models are called through the gateway, the one host the egress policy
  # allows (see index-substrate.ts).
  - name: MODEL_GATEWAY_URL
    value: ${MODEL_GATEWAY_URL}
  - name: AGENT_MODEL
    value: ${AGENT_MODEL}
  # The golden snapshot (and every resume) waits for this.
  wakeupProbe:
    httpGet:
      path: /api/__health
      port: 80
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  # FULL: suspend/pause capture process memory as well as the filesystem, so
  # a resumed box continues exactly where it left off.
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  # gs:// even on kind: the kind install maps it onto its in-cluster rustfs.
  storageLocation: gs://${BUCKET}/${ATESPACE}/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
